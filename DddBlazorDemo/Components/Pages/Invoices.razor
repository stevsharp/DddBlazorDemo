@page "/invoices"
@inherits CommandPage
@inject IDispatcher Dispatcher
@using DddBlazorDemo.Application.Billing.Queries
@using DddBlazorDemo.Cqrs
@using DddBlazorDemo.Application.ReadModels
@using DddBlazorDemo.Billing.Application.Commands
@using DddBlazorDemo.Billing.Application.Queries

<PageHeader Title="Invoices" Subtitle="Draft invoices can take lines; validating one is final and creates a document.">
    <Actions>
        <button type="button" class="btn btn-primary" disabled="@(customers.Count == 0)"
                @onclick="() => form?.SetOpen(true)">+ New invoice</button>
    </Actions>
</PageHeader>

<StatusBanner IsBusy="IsBusy" Message="@Message" IsError="IsError" OnClose="ClearMessage" />

@if (customers.Count == 0)
{
    <section class="card notice">
        You need a customer before you can create an invoice.
        <a href="customers" class="btn btn-sm">Go to Customers</a>
    </section>
}
else
{
    <Collapsible @ref="form" Title="New invoice" Hint="Click to open the form">

        <DataForm Model="Form" OnSubmit="Create" SubmitText="Create invoice" Disabled="@IsBusy">
            <FormField TModel="InvoiceForm" TValue="string" For="m => m.CustomerId" Required Span="2" Label="Customer"
                       Placeholder="— choose a customer —" Options="CustomerOptions" />
            <FormField TModel="InvoiceForm" TValue="string" For="m => m.Number" Required Label="Invoice number" />
            <FormField TModel="InvoiceForm" TValue="string" For="m => m.Currency" Required MaxLength="3" />
            <FormField TModel="InvoiceForm" TValue="string" For="m => m.ProviderEan" Required Span="2" Label="Provider EAN / GLN" />
        </DataForm>

    </Collapsible>
}

<section class="card">
    <h2 class="card-title">All invoices <span class="count">@invoices.Count</span></h2>

    <DataGrid Items="invoices" RowKey="i => i.Id" EmptyText="No invoices yet.">
        <GridColumn TItem="InvoiceListItemDto" Title="Number" Value="i => i.Number">
            <strong>@context.Number</strong>
        </GridColumn>
        <GridColumn TItem="InvoiceListItemDto" Title="Provider" Value="i => i.ProviderEan">
            <code>@context.ProviderEan</code>
        </GridColumn>
        <GridColumn TItem="InvoiceListItemDto" Title="Status" Value="i => i.Status">
            <span class="badge badge-@context.Status.ToLowerInvariant()">@context.Status</span>
        </GridColumn>
        <GridColumn TItem="InvoiceListItemDto" Title="Total" Value="i => i.TotalAmount" CssClass="num">
            @context.TotalAmount.ToString("N2") <span class="muted">@context.CurrencyCode</span>
        </GridColumn>
        <GridColumn TItem="InvoiceListItemDto" Title="" CssClass="actions" Sortable="false">
            @if (context.Status != "Draft")
            {
                <span class="muted">Locked</span>
            }
            else if (lineFor == context.Id)
            {
                @* Inline "add line" editor for this row *@
                <div class="inline-form">
                    <input placeholder="Description" @bind="LineDescription" disabled="@IsBusy" />
                    <input type="number" step="0.01" min="0.01" placeholder="Amount" style="width: 100px"
                           @bind="LineAmount" disabled="@IsBusy" />
                    <button type="button" class="btn btn-sm btn-primary" disabled="@IsBusy"
                            @onclick="() => AddLine(context.Id)">Add</button>
                    <button type="button" class="btn btn-sm" disabled="@IsBusy"
                            @onclick="() => lineFor = null">Cancel</button>
                </div>
            }
            else if (confirmFor == context.Id)
            {
                @* Two-step confirm: validation cannot be undone *@
                <span class="confirm">
                    Validate <strong>@context.Number</strong>? This is final.
                    <button type="button" class="btn btn-sm btn-danger" disabled="@IsBusy"
                            @onclick="() => Validate(context.Id)">Yes, validate</button>
                    <button type="button" class="btn btn-sm" disabled="@IsBusy"
                            @onclick="() => confirmFor = null">Cancel</button>
                </span>
            }
            else
            {
                <button type="button" class="btn btn-sm" disabled="@IsBusy"
                        @onclick="() => OpenLineEditor(context.Id)">+ Line</button>
                <button type="button" class="btn btn-sm btn-primary"
                        disabled="@(IsBusy || context.TotalAmount <= 0)"
                        title="@(context.TotalAmount <= 0 ? "Add at least one line first" : "Validate this invoice")"
                        @onclick="() => confirmFor = context.Id">Validate</button>
            }
        </GridColumn>
    </DataGrid>
</section>

@code {
    private sealed class InvoiceForm
    {
        public string CustomerId { get; set; } = "";
        public string Number { get; set; } = "INV-1001";
        public string ProviderEan { get; set; } = "7601000237088";
        public string Currency { get; set; } = "EUR";
    }

    private IEnumerable<(string Value, string Text)> CustomerOptions =>
        customers.Select(c => (c.Id.ToString(), $"{c.Name} · {c.VatNumber} · {c.City}"));

    private Collapsible? form;
    private InvoiceForm Form = new();
    private List<InvoiceListItemDto> invoices = new();
    private List<CustomerListItemDto> customers = new();

    // Row-level UI state
    private Guid? lineFor;
    private Guid? confirmFor;
    private string LineDescription = "";
    private decimal LineAmount = 50m;

    protected override async Task Reload()
    {
        var invoiceResult = await Dispatcher.Query<ListInvoicesQuery, IReadOnlyList<InvoiceListItemDto>>(
            new ListInvoicesQuery(), CancellationToken.None);
        invoices = invoiceResult.ToList();

        var customerResult = await Dispatcher.Query<ListCustomersQuery, IReadOnlyList<CustomerListItemDto>>(
            new ListCustomersQuery(), CancellationToken.None);
        customers = customerResult.ToList();
    }

    private void OpenLineEditor(Guid invoiceId)
    {
        confirmFor = null;
        lineFor = invoiceId;
        LineDescription = "";
    }

    private Task Create()
    {
        if (!Guid.TryParse(Form.CustomerId, out var customerId))
        {
            ShowError("Choose a customer first.");
            return Task.CompletedTask;
        }

        var number = Form.Number;
        return Run(async () =>
            {
                await Dispatcher.Send<CreateInvoiceCommand, Guid>(
                    new CreateInvoiceCommand(Form.Number, Form.ProviderEan, Form.Currency, customerId),
                    CancellationToken.None);

                Form = new InvoiceForm { CustomerId = Form.CustomerId, Number = NextNumber(Form.Number) };
                form?.SetOpen(false);
            },
            $"Invoice {number} created.");
    }

    private Task AddLine(Guid invoiceId)
    {
        var description = LineDescription;
        var amount = LineAmount;
        return Run(async () =>
            {
                await Dispatcher.Send<AddInvoiceLineCommand, Unit>(
                    new AddInvoiceLineCommand(invoiceId, description, amount), CancellationToken.None);
                LineDescription = "";           // keep the editor open for the next line
            },
            $"Line \"{description}\" added.");
    }

    private Task Validate(Guid invoiceId)
    {
        confirmFor = null;
        return Run(() => Dispatcher.Send<ValidateInvoiceCommand, Unit>(
                new ValidateInvoiceCommand(invoiceId), CancellationToken.None),
            "Invoice validated. Its document will appear on the Documents page shortly.");
    }

    /// <summary>INV-1001 → INV-1002 so the next invoice number is ready without typing.</summary>
    private static string NextNumber(string current)
    {
        var i = current.Length;
        while (i > 0 && char.IsDigit(current[i - 1])) i--;
        if (i == current.Length) return current;
        var digits = current[i..];
        return current[..i] + (long.Parse(digits) + 1).ToString().PadLeft(digits.Length, '0');
    }
}
