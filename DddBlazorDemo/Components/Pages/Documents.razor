@page "/documents"
@inherits CommandPage
@inject IDispatcher Dispatcher
@using DddBlazorDemo.Cqrs
@using DddBlazorDemo.Application.ReadModels
@using DddBlazorDemo.Documents.Application.Queries

<PageHeader Title="Documents" Subtitle="Created asynchronously by the outbox when an invoice is validated, so they can lag by a poll interval.">
    <Actions>
        <button type="button" class="btn" disabled="@IsBusy" @onclick="Refresh">↻ Refresh</button>
    </Actions>
</PageHeader>

<StatusBanner IsBusy="IsBusy" Message="@Message" IsError="IsError" OnClose="ClearMessage" />

<section class="card">
    <h2 class="card-title">All documents <span class="count">@documents.Count</span></h2>

    <DataGrid Items="documents" RowKey="d => d.Id" EmptyText="No documents yet. Validate an invoice, then refresh.">
        <GridColumn TItem="DocumentListItemDto" Title="File" Value="d => d.FileName">
            <strong>@context.FileName</strong>
        </GridColumn>
        <GridColumn TItem="DocumentListItemDto" Title="Invoice" Value="d => d.InvoiceId" Sortable="false">
            <code title="@context.InvoiceId">@context.InvoiceId.ToString()[..8]…</code>
        </GridColumn>
        <GridColumn TItem="DocumentListItemDto" Title="Workflow" Value="d => d.WorkflowStatus">
            <span class="badge badge-neutral">@context.WorkflowStatus</span>
        </GridColumn>
        <GridColumn TItem="DocumentListItemDto" Title="PDF" Value="d => d.IsPdfUpToDate">
            @(context.IsPdfUpToDate ? "✓ up to date" : "– pending")
        </GridColumn>
        <GridColumn TItem="DocumentListItemDto" Title="Created" Value="d => d.CreatedAtUtc" CssClass="num">
            @context.CreatedAtUtc.ToLocalTime().ToString("g")
        </GridColumn>
    </DataGrid>
</section>

@code {
    private List<DocumentListItemDto> documents = new();

    protected override async Task Reload()
    {
        var result = await Dispatcher.Query<ListDocumentsQuery, IReadOnlyList<DocumentListItemDto>>(
            new ListDocumentsQuery(), CancellationToken.None);
        documents = result.ToList();
    }

    private Task Refresh() => Run(() => Task.CompletedTask, "Refreshed.");
}
